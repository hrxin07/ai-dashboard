// Prisma data model for the AI career planning workbench.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum TaskType {
  COURSE
  PROJECT
  COMPETITION
  JOB_PREP
  OTHER
}

enum TaskPriority {
  HIGH
  MEDIUM
  LOW
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

model User {
  id           String       @id @default(cuid()) @db.VarChar(30)
  username     String       @unique @db.VarChar(64)
  email        String       @unique @db.VarChar(191)
  passwordHash String       @db.VarChar(191)
  profile      Profile?
  careerPlan   CareerPlan?
  tasks        LearningTask[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([createdAt])
}

model Profile {
  id         String   @id @default(cuid()) @db.VarChar(30)
  userId     String   @unique @db.VarChar(30)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  realName   String?  @db.VarChar(64)
  major      String   @default("人工智能") @db.VarChar(64)
  grade      String?  @db.VarChar(32)
  school     String?  @db.VarChar(191)
  skills     String?  @db.Text
  interests  String?  @db.Text
  bio        String?  @db.Text
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
}

model CareerPlan {
  id              String   @id @default(cuid()) @db.VarChar(30)
  userId          String   @unique @db.VarChar(30)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetDirection String   @db.VarChar(191)
  targetPosition  String   @db.VarChar(191)
  targetCity      String?  @db.VarChar(191)
  targetDate      DateTime?
  skillFoundation String?  @db.Text
  strengths       String?  @db.Text
  weaknesses      String?  @db.Text
  planContent     String   @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model LearningTask {
  id          String       @id @default(cuid()) @db.VarChar(30)
  userId      String       @db.VarChar(30)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String       @db.VarChar(191)
  type        TaskType     @default(OTHER)
  priority    TaskPriority  @default(MEDIUM)
  status      TaskStatus   @default(TODO)
  deadline    DateTime?
  scheduleDate DateTime?
  description String?      @db.Text
  progress    Int          @default(0)
  subtasks    LearningSubtask[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId, status])
  @@index([userId, deadline])
  @@index([userId, scheduleDate])
}

model LearningSubtask {
  id        String       @id @default(cuid()) @db.VarChar(30)
  taskId    String       @db.VarChar(30)
  task      LearningTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title     String       @db.VarChar(191)
  completed Boolean      @default(false)
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([taskId, sortOrder])
}

model CareerPath {
  id          String   @id @default(cuid()) @db.VarChar(30)
  name        String   @unique @db.VarChar(191)
  description String   @db.Text
  skills      String   @db.Text
  courses     String   @db.Text
  projects    String   @db.Text
  prospect    String   @db.Text
  tags        String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}




